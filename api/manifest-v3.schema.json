{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shixpeer Ward signed snapshot payload v3",
  "description": "Verify Ed25519 on exact decoded envelope payload bytes before trusting; total bytes <=4 GiB, unique slots, TTL <=7 days. Objects are already block-compressed WDB files, served directly. See docs/distribution.md.",
  "type": "object",
  "required": [
    "version",
    "format",
    "revision",
    "created_at",
    "expires_at",
    "profile",
    "generation",
    "sources",
    "objects"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "format": {
      "const": 3
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "profile": {
      "enum": [
        "all",
        "prototype"
      ]
    },
    "generation": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "advisories",
          "inputs",
          "cached",
          "checked_at"
        ]
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 896,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "sha256",
          "bytes",
          "rows"
        ],
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^([pvr]-[a-f0-9]{2}|s-[0-7][a-f0-9])$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 40,
            "maximum": 134217728
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4000000
          }
        }
      }
    }
  }
}
